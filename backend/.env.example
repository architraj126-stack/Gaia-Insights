# Application
APP_NAME="Gaia Insights API"
APP_ENV="development"
DEBUG=true
HOST="127.0.0.1"
PORT=8000

# CORS (JSON string array or comma-separated)
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173"]'

# Storage & Cache
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/earth_science"
DATA_CACHE_DIR="data/cache"

# Logging & Security
LOG_LEVEL="INFO"
SECRET_KEY="dev-insecure-secret-key-change-in-production"
ADMIN_TOKEN="change-me-to-a-secure-random-token-in-production"
