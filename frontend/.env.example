# Gaia Insights - Frontend Environment Variables

# Local Development:
# Leave empty to use default Vite dev proxy (/api -> http://127.0.0.1:8000)
# VITE_API_BASE_URL=

# Vercel Production Deployment:
# Option 1 (Recommended): Leave empty! The included Vercel Edge proxy will automatically route /api/*
# to the BACKEND_URL environment variable configured in your Vercel Project Settings.
#
# Option 2 (Direct Cross-Origin): Set this to your deployed backend URL:
# VITE_API_BASE_URL=https://your-backend-service.railway.app
